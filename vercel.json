{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --omit=optional",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{docs,fonts,media,src}/**"
    }
  },
  "rewrites": [{ "source": "/:path*", "destination": "/api?__path=:path*" }],
  "crons": [{ "path": "/api/cleanup", "schedule": "0 3 * * *" }]
}
